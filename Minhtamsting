--==============================================================
-- AXIOM GAG2 - AUTO SELL V2
-- Steven -> Open Menu -> Sell Inventory
--==============================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")

local Player = Players.LocalPlayer

local SELL_DEBUG = true

local function SellLog(...)
    if SELL_DEBUG then
        print("[AXIOM SELL]", ...)
    end
end

--==============================================================
-- CHARACTER
--==============================================================

local function GetCharacter()
    return Player.Character or Player.CharacterAdded:Wait()
end

local function GetRoot()
    local char = GetCharacter()

    return char:FindFirstChild("HumanoidRootPart")
        or char:WaitForChild("HumanoidRootPart", 5)
end

--==============================================================
-- TEXT NORMALIZER
--==============================================================

local function Normalize(str)
    str = tostring(str or "")
    str = string.lower(str)

    str = str:gsub("[%p%c]", " ")
    str = str:gsub("%s+", " ")

    return str
end

local function Contains(str, text)
    return string.find(
        Normalize(str),
        Normalize(text),
        1,
        true
    ) ~= nil
end

--==============================================================
-- OBJECT DESCRIPTION
--==============================================================

local function GetDescription(obj)

    local text = obj.Name

    if obj:IsA("ProximityPrompt") then
        text = text
            .. " "
            .. tostring(obj.ActionText)
            .. " "
            .. tostring(obj.ObjectText)
    end

    local parent = obj.Parent

    local depth = 0

    while parent and depth < 5 do
        text = text .. " " .. parent.Name

        parent = parent.Parent
        depth += 1
    end

    return text
end

--==============================================================
-- FIND STEVEN / SELL STAND
--==============================================================

local function FindStevenPrompt()

    local bestPrompt = nil

    for _, obj in ipairs(Workspace:GetDescendants()) do

        if obj:IsA("ProximityPrompt") then

            local info = GetDescription(obj)

            -- Ưu tiên prompt của Steven
            if Contains(info, "steven") then

                SellLog(
                    "Found Steven:",
                    obj:GetFullName()
                )

                return obj
            end

            -- Fallback Sell Stand
            if Contains(info, "sell stand")
                or Contains(info, "sellstand")
                or Contains(info, "sell stuff") then

                bestPrompt = obj
            end
        end
    end

    if bestPrompt then
        SellLog(
            "Found Sell Stand:",
            bestPrompt:GetFullName()
        )
    end

    return bestPrompt
end

--==============================================================
-- GET PROMPT POSITION
--==============================================================

local function GetPosition(obj)

    if not obj then
        return nil
    end

    local parent = obj.Parent

    if parent:IsA("BasePart") then
        return parent.Position
    end

    local model = obj:FindFirstAncestorOfClass("Model")

    if model then

        local part =
            model.PrimaryPart
            or model:FindFirstChild("HumanoidRootPart")
            or model:FindFirstChildWhichIsA("BasePart")

        if part then
            return part.Position
        end
    end

    return nil
end

--==============================================================
-- FIRE PROMPT
--==============================================================

local function TriggerPrompt(prompt)

    if not prompt then
        return false
    end

    prompt.HoldDuration = 0

    -- Executor support
    if fireproximityprompt then

        local success = pcall(function()
            fireproximityprompt(prompt)
        end)

        if success then
            return true
        end
    end

    -- Fallback
    local success = pcall(function()

        prompt:InputHoldBegin()

        task.wait(0.05)

        prompt:InputHoldEnd()

    end)

    return success
end

--==============================================================
-- CHECK SELL INVENTORY BUTTON
--==============================================================

local function IsSellInventoryButton(obj)

    if not (
        obj:IsA("TextButton")
        or obj:IsA("ImageButton")
    ) then
        return false
    end

    local text = obj.Name

    if obj:IsA("TextButton") then
        text = text .. " " .. obj.Text
    end

    -- xem cả TextLabel nằm trong button
    for _, child in ipairs(obj:GetDescendants()) do

        if child:IsA("TextLabel")
            or child:IsA("TextButton") then

            text = text
                .. " "
                .. tostring(child.Text)
        end
    end

    text = Normalize(text)

    -- chính xác nhất
    if Contains(text, "sell inventory") then
        return true
    end

    -- các wording khác
    if Contains(text, "sell all") then
        return true
    end

    if Contains(text, "sell everything") then
        return true
    end

    if Contains(text, "sell crops") then
        return true
    end

    return false
end

--==============================================================
-- FIND SELL INVENTORY BUTTON
--==============================================================

local function FindSellInventoryButton()

    local gui = Player:FindFirstChild("PlayerGui")

    if not gui then
        return nil
    end

    for _, obj in ipairs(gui:GetDescendants()) do

        if IsSellInventoryButton(obj) then

            SellLog(
                "Sell Inventory button:",
                obj:GetFullName()
            )

            return obj
        end
    end

    return nil
end

--==============================================================
-- PRESS GUI BUTTON
--==============================================================

local function PressButton(button)

    if not button then
        return false
    end

    -- Method 1
    if firesignal then

        local success = pcall(function()
            firesignal(button.Activated)
        end)

        if success then
            SellLog("Clicked with firesignal")
            return true
        end
    end

    -- Method 2
    local success = pcall(function()
        button:Activate()
    end)

    if success then
        SellLog("Clicked with Activate")
        return true
    end

    -- Method 3 - real screen click
    local pos = button.AbsolutePosition
    local size = button.AbsoluteSize

    if size.X > 0 and size.Y > 0 then

        local x = pos.X + size.X / 2
        local y = pos.Y + size.Y / 2

        success = pcall(function()

            VirtualInputManager:SendMouseButtonEvent(
                x,
                y,
                0,
                true,
                game,
                0
            )

            task.wait(0.05)

            VirtualInputManager:SendMouseButtonEvent(
                x,
                y,
                0,
                false,
                game,
                0
            )

        end)

        if success then
            SellLog("Clicked using screen position")
            return true
        end
    end

    return false
end

--==============================================================
-- WAIT FOR SELL MENU
--==============================================================

local function WaitForSellButton(timeout)

    timeout = timeout or 4

    local start = tick()

    repeat

        local button = FindSellInventoryButton()

        if button then
            return button
        end

        task.wait(0.1)

    until tick() - start >= timeout

    return nil
end

--==============================================================
-- SELL EVERYTHING
--==============================================================

local Selling = false

local function SellAll()

    if Selling then
        return false
    end

    Selling = true

    SellLog("Starting sell...")

    local root = GetRoot()

    if not root then

        Selling = false

        SellLog("HumanoidRootPart missing")

        return false
    end

    --==========================================================
    -- CASE 1:
    -- Menu sell đang mở sẵn
    --==========================================================

    local existingButton =
        FindSellInventoryButton()

    if existingButton then

        SellLog("Sell menu already open")

        local clicked =
            PressButton(existingButton)

        task.wait(0.5)

        Selling = false

        return clicked
    end

    --==========================================================
    -- FIND STEVEN
    --==========================================================

    local prompt =
        FindStevenPrompt()

    if not prompt then

        Selling = false

        warn(
            "[AXIOM SELL] Không tìm thấy Steven / Sell Stand"
        )

        return false
    end

    local position =
        GetPosition(prompt)

    if not position then

        Selling = false

        warn(
            "[AXIOM SELL] Không lấy được vị trí Steven"
        )

        return false
    end

    --==========================================================
    -- SAVE POSITION
    --==========================================================

    local oldCFrame =
        root.CFrame

    --==========================================================
    -- TELEPORT TO STEVEN
    --==========================================================

    SellLog("Teleport -> Steven")

    root.CFrame =
        CFrame.new(
            position + Vector3.new(0, 3, 3)
        )

    task.wait(0.5)

    --==========================================================
    -- OPEN SELL MENU
    --==========================================================

    SellLog("Opening sell menu")

    TriggerPrompt(prompt)

    --==========================================================
    -- WAIT SELL INVENTORY
    --==========================================================

    local button =
        WaitForSellButton(4)

    if not button then

        -- đôi khi prompt đầu tiên chưa nhận
        SellLog("Retry Steven prompt")

        TriggerPrompt(prompt)

        button =
            WaitForSellButton(3)
    end

    --==========================================================
    -- CLICK SELL INVENTORY
    --==========================================================

    local sold = false

    if button then

        SellLog("Click -> Sell Inventory")

        sold =
            PressButton(button)

        task.wait(1)

    else

        warn(
            "[AXIOM SELL] Menu mở nhưng không tìm thấy nút Sell Inventory"
        )
    end

    --==========================================================
    -- RETURN TO FARM
    --==========================================================

    if root
        and root.Parent
        and oldCFrame then

        root.CFrame =
            oldCFrame
    end

    Selling = false

    if sold then
        SellLog("SELL COMPLETE")
    else
        SellLog("SELL FAILED")
    end

    return sold
end


--[[
    ============================================================
        AXIOM - ROBLOX AFK / LOW-END PERFORMANCE OPTIMIZER
    ============================================================

    Mục tiêu:
    - Giảm GPU
    - Giảm CPU
    - Giảm hiệu ứng hình ảnh
    - Giảm tải rendering
    - Không xóa UI
    - Không xóa nhân vật LocalPlayer
    - Không chạy vòng lặp quét toàn map mỗi frame
    - Hạn chế làm hỏng auto farm

    Lưu ý:
    Một số executor không hỗ trợ setfpscap().
--]]

-- ============================================================
-- SERVICES
-- ============================================================

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local StarterGui = game:GetService("StarterGui")

local LocalPlayer = Players.LocalPlayer

-- ============================================================
-- CONFIG
-- ============================================================

local CONFIG = {

    -- FPS thấp hơn = giảm CPU/GPU mạnh hơn
    FPS_CAP = 12,

    -- Tắt texture
    DISABLE_TEXTURES = true,

    -- Tắt particle / trail / beam
    DISABLE_EFFECTS = true,

    -- Tắt shadow
    DISABLE_SHADOWS = true,

    -- Tắt âm thanh
    MUTE_SOUND = true,

    -- Làm Part đơn giản hơn
    SIMPLIFY_PARTS = true,

    -- Ẩn vật thể ở xa
    HIDE_DISTANT_OBJECTS = true,

    -- Khoảng cách render giả lập
    MAX_RENDER_DISTANCE = 250,

    -- Thời gian cập nhật kiểm tra vật thể ở xa
    DISTANCE_UPDATE_DELAY = 3,

    -- Số object xử lý mỗi batch
    BATCH_SIZE = 300,

    -- Thời gian nghỉ giữa batch
    BATCH_DELAY = 0.03,

    -- Không đụng vào nhân vật
    KEEP_CHARACTERS = true,

    -- Không đụng UI
    KEEP_UI = true,
}

-- ============================================================
-- FPS CAP
-- ============================================================

pcall(function()
    if setfpscap then
        setfpscap(CONFIG.FPS_CAP)
    end
end)

-- ============================================================
-- GRAPHICS QUALITY
-- ============================================================

pcall(function()
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
end)

-- ============================================================
-- LIGHTING
-- ============================================================

local function optimizeLighting()

    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.Brightness = 1
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.FogStart = 0
        Lighting.FogEnd = 100000
    end)

    for _, object in ipairs(Lighting:GetChildren()) do

        if object:IsA("BloomEffect")
        or object:IsA("BlurEffect")
        or object:IsA("ColorCorrectionEffect")
        or object:IsA("DepthOfFieldEffect")
        or object:IsA("SunRaysEffect") then

            pcall(function()
                object.Enabled = false
            end)

        elseif object:IsA("Atmosphere") then

            pcall(function()
                object.Density = 0
                object.Haze = 0
                object.Glare = 0
            end)

        end
    end
end

optimizeLighting()

-- ============================================================
-- SOUND
-- ============================================================

if CONFIG.MUTE_SOUND then

    pcall(function()
        SoundService.Volume = 0
    end)

end

-- ============================================================
-- CHECK SAFE OBJECT
-- ============================================================

local function isCharacterObject(object)

    if not CONFIG.KEEP_CHARACTERS then
        return false
    end

    local model = object:FindFirstAncestorOfClass("Model")

    if not model then
        return false
    end

    if Players:GetPlayerFromCharacter(model) then
        return true
    end

    return false
end

-- ============================================================
-- OPTIMIZE OBJECT
-- ============================================================

local function optimizeObject(object)

    if not object then
        return
    end

    ------------------------------------------------------------
    -- PARTICLES
    ------------------------------------------------------------

    if CONFIG.DISABLE_EFFECTS then

        if object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Beam")
        or object:IsA("Smoke")
        or object:IsA("Fire")
        or object:IsA("Sparkles") then

            pcall(function()
                object.Enabled = false
            end)

            return
        end

    end

    ------------------------------------------------------------
    -- LIGHT SOURCES
    ------------------------------------------------------------

    if object:IsA("PointLight")
    or object:IsA("SpotLight")
    or object:IsA("SurfaceLight") then

        pcall(function()
            object.Enabled = false
        end)

        return
    end

    ------------------------------------------------------------
    -- TEXTURES
    ------------------------------------------------------------

    if CONFIG.DISABLE_TEXTURES then

        if object:IsA("Texture")
        or object:IsA("Decal") then

            pcall(function()
                object.Transparency = 1
            end)

            return
        end

    end

    ------------------------------------------------------------
    -- PARTS
    ------------------------------------------------------------

    if object:IsA("BasePart") then

        if isCharacterObject(object) then
            return
        end

        pcall(function()

            if CONFIG.DISABLE_SHADOWS then
                object.CastShadow = false
            end

            if CONFIG.SIMPLIFY_PARTS then

                object.Material = Enum.Material.SmoothPlastic

                object.Reflectance = 0

            end
        end)

        return
    end

    ------------------------------------------------------------
    -- MESH
    ------------------------------------------------------------

    if object:IsA("SpecialMesh") then

        pcall(function()
            object.TextureId = ""
        end)

    end

end

-- ============================================================
-- INITIAL WORKSPACE OPTIMIZATION
-- ============================================================

local function optimizeWorkspace()

    local descendants = Workspace:GetDescendants()

    local processed = 0

    for i = 1, #descendants do

        optimizeObject(descendants[i])

        processed += 1

        if processed >= CONFIG.BATCH_SIZE then

            processed = 0

            task.wait(CONFIG.BATCH_DELAY)

        end

    end

end

task.spawn(optimizeWorkspace)

-- ============================================================
-- OPTIMIZE NEW OBJECTS
-- ============================================================

Workspace.DescendantAdded:Connect(function(object)

    task.defer(function()

        optimizeObject(object)

    end)

end)

Lighting.ChildAdded:Connect(function()

    task.defer(optimizeLighting)

end)

-- ============================================================
-- DISTANCE CULLING
-- ============================================================

local HiddenObjects = {}

local function getRootPart()

    local character = LocalPlayer.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")

end

local function distanceCull()

    if not CONFIG.HIDE_DISTANT_OBJECTS then
        return
    end

    while task.wait(CONFIG.DISTANCE_UPDATE_DELAY) do

        local root = getRootPart()

        if not root then
            continue
        end

        local rootPosition = root.Position

        local objects = Workspace:GetDescendants()

        local handled = 0

        for _, object in ipairs(objects) do

            if object:IsA("BasePart")
            and not isCharacterObject(object)
            and not object:IsDescendantOf(LocalPlayer.Character or Workspace) then

                local distance = (object.Position - rootPosition).Magnitude

                if distance > CONFIG.MAX_RENDER_DISTANCE then

                    if HiddenObjects[object] == nil then

                        HiddenObjects[object] = object.LocalTransparencyModifier

                    end

                    object.LocalTransparencyModifier = 1

                else

                    if HiddenObjects[object] ~= nil then

                        object.LocalTransparencyModifier =
                            HiddenObjects[object]

                        HiddenObjects[object] = nil

                    end

                end

            end

            handled += 1

            if handled >= CONFIG.BATCH_SIZE then

                handled = 0

                task.wait()

            end

        end

    end

end

task.spawn(distanceCull)

-- ============================================================
-- TERRAIN OPTIMIZATION
-- ============================================================

pcall(function()

    local Terrain = Workspace:FindFirstChildOfClass("Terrain")

    if Terrain then

        Terrain.WaterWaveSize = 0
        Terrain.WaterWaveSpeed = 0
        Terrain.WaterReflectance = 0
        Terrain.WaterTransparency = 1

        Terrain.Decoration = false

    end

end)

-- ============================================================
-- REMOVE POST PROCESSING ADDED LATER
-- ============================================================

task.spawn(function()

    while task.wait(10) do

        optimizeLighting()

    end

end)

-- ============================================================
-- PERIODIC GARBAGE COLLECTION
-- ============================================================

task.spawn(function()

    while task.wait(30) do

        pcall(function()

            if collectgarbage then
                collectgarbage("collect")
            end

        end)

    end

end)

-- ============================================================
-- CHARACTER RESPAWN
-- ============================================================

LocalPlayer.CharacterAdded:Connect(function()

    task.wait(3)

    pcall(function()

        if setfpscap then
            setfpscap(CONFIG.FPS_CAP)
        end

    end)

end)

print("[AXIOM] Performance Optimizer loaded.")
